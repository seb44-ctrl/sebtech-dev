---
// Metrics & Enterprise Trust Bar Component
---
<section class="border-y border-slate-900 bg-slate-950/40 py-16 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <!-- Metric 1 -->
        <div class="p-6 rounded-xl bg-slate-900/30 border border-slate-800/60">
            <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 font-mono">$50M+</div>
            <div class="text-xs uppercase tracking-widest text-emerald-400 font-medium">Client Revenue Processed</div>
        </div>

        <!-- Metric 2 -->
        <div class="p-6 rounded-xl bg-slate-900/30 border border-slate-800/60">
            <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 font-mono">99.99%</div>
            <div class="text-xs uppercase tracking-widest text-emerald-400 font-medium">System Uptime SLA</div>
        </div>

        <!-- Metric 3 -->
        <div class="p-6 rounded-xl bg-slate-900/30 border border-slate-800/60">
            <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 font-mono">15+</div>
            <div class="text-xs uppercase tracking-widest text-emerald-400 font-medium">Enterprise Partnerships</div>
        </div>

        <!-- Metric 4 -->
        <div class="p-6 rounded-xl bg-slate-900/30 border border-slate-800/60">
            <div class="text-3xl md:text-4xl font-extrabold text-white mb-1 font-mono">&lt; 24h</div>
            <div class="text-xs uppercase tracking-widest text-emerald-400 font-medium">Average Deployment SLA</div>
        </div>
    </div>
</section>