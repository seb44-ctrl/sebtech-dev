---
// Services Component
---
<section id="services" class="py-28 border-t border-slate-900 px-6 max-w-7xl mx-auto">
    <div class="max-w-2xl mb-16">
        <h2 class="text-xs font-semibold tracking-widest uppercase text-emerald-400 mb-3">Core Expertise</h2>
        <p class="text-3xl md:text-4xl font-bold tracking-tight text-white">An integrated approach to digital dominance.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Service 1: Branding & Design -->
        <div class="p-8 rounded-xl bg-slate-900/50 border border-slate-800/85 hover:border-slate-700 transition-all flex flex-col justify-between">
            <div>
                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold mb-6">01</div>
                <h3 class="text-xl font-semibold text-white mb-3">Branding & UI/UX</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Crafting distinct brand identities, design systems, and intuitive user experiences that captivate target audiences and drive conversion.
                </p>
            </div>
            <div class="mt-8 pt-4 border-t border-slate-800/60 text-xs font-medium text-slate-500">
                Brand Strategy / Design Systems / UI/UX
            </div>
        </div>

        <!-- Service 2: Software Engineering -->
        <div class="p-8 rounded-xl bg-slate-900/50 border border-slate-800/85 hover:border-slate-700 transition-all flex flex-col justify-between">
            <div>
                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold mb-6">02</div>
                <h3 class="text-xl font-semibold text-white mb-3">Software Engineering</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    End-to-end development of dynamic web platforms, enterprise applications, and APIs built on robust frameworks like React, Next.js, and TypeScript.
                </p>
            </div>
            <div class="mt-8 pt-4 border-t border-slate-800/60 text-xs font-medium text-slate-500">
                Full-Stack Apps / REST & GraphQL / Mobile
            </div>
        </div>

        <!-- Service 3: Cloud Infrastructure & DevOps -->
        <div class="p-8 rounded-xl bg-slate-900/50 border border-slate-800/85 hover:border-slate-700 transition-all flex flex-col justify-between">
            <div>
                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold mb-6">03</div>
                <h3 class="text-xl font-semibold text-white mb-3">Cloud & DevOps</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Resilient, automated cloud environments utilizing containerization and CI/CD pipelines to guarantee zero-downtime scalability and security.
                </p>
            </div>
            <div class="mt-8 pt-4 border-t border-slate-800/60 text-xs font-medium text-slate-500">
                AWS / Docker / Automated Pipelines
            </div>
        </div>

        <!-- Service 4: Digital Marketing & Growth -->
        <div class="p-8 rounded-xl bg-slate-900/50 border border-slate-800/85 hover:border-slate-700 transition-all flex flex-col justify-between">
            <div>
                <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold mb-6">04</div>
                <h3 class="text-xl font-semibold text-white mb-3">Marketing & Growth</h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                    Data-driven growth campaigns, technical SEO, conversion rate optimization (CRO), and go-to-market strategies that scale acquisition.
                </p>
            </div>
            <div class="mt-8 pt-4 border-t border-slate-800/60 text-xs font-medium text-slate-500">
                Technical SEO / Analytics / Growth Strategy
            </div>
        </div>
    </div>
</section>